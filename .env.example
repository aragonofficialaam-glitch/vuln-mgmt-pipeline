# Copy this file to .env and fill in real values. NEVER commit .env.

# --- Database ---
DATABASE_URL=sqlite:///db/data/vulnmgmt.db

# --- Enrichment ---
# Free key: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# --- Ticketing (GitHub Issues) ---
# Fine-grained PAT, scoped ONLY to this repo, permission: Issues (read/write)
GITHUB_TOKEN=
GITHUB_REPO=aragonofficialaam-glitch/vuln-mgmt-pipeline

# --- AI summaries (local model via Ollama, no external API) ---
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=

# --- AWS ---
# No access keys are used. Prowler runs from AWS CloudShell with temporary credentials.
AWS_REGION=us-east-2